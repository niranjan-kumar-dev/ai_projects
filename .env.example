# Copy this file to `.env` and fill in your values. `.env` is git-ignored.

# ---------- Environment & database ----------
# APP_ENV picks the database automatically:
#   development -> LOCAL_DATABASE_URL        (your machine)
#   production  -> PRODUCTION_DATABASE_URL   (Streamlit Community Cloud / server; set via secrets/env vars there)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
APP_ENV=development
LOCAL_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/chat_with_website
PRODUCTION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# DATABASE_URL=   optional: if set, overrides both of the above (backward compatible)

# ---------- Embeddings ----------
# huggingface (free, local, 384 dims) | openai (1536 dims) | gemini (3072 dims)
# Changing the provider changes the vector size -> run `python scripts/init_db.py --reset-chunks` and re-ingest.
EMBEDDING_PROVIDER=huggingface
# Optional overrides (defaults are picked per provider):
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIM=384
# OpenAI large model (better quality, 3072 dims):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

# ---------- Chat LLM ----------
# ollama (free, local) | openai | gemini   -- can be switched at any time
LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ---------- API keys (only for the paid providers) ----------
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------- Crawler ----------
USER_AGENT=ChatWithWebsiteBot/0.1 (+contact: you@example.com)
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_DELAY_SECONDS=0.5
CRAWL_RESPECT_ROBOTS=true

# ---------- Chunking / retrieval ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
SCORE_THRESHOLD=0.25

LOG_LEVEL=INFO
